---                                                                                          
import BaseLayout from '../layouts/BaseLayout.astro';                                        
import { site } from '../data/site.js';                                                      
---                                                                                          
																							
<BaseLayout>                                                                                 
	<section class="mx-auto max-w-5xl px-4 py-16">                                             
	<p class="font-mono text-sm text-accent">// scaffold check</p>                           
	<h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{site.name}</h1>          
	<p class="mt-4 max-w-2xl text-muted">{site.bio}</p>                                      
	</section>                                                                                 
</BaseLayout>  