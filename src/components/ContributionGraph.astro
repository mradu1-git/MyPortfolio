---
/**
 * @typedef {import('../lib/activity.js').DayCell} DayCell
 * @typedef {import('../lib/activity.js').CommitItem} CommitItem
 */

const {
  label,
  username,
  profileUrl,
  total = 0,
  weeks = [],
  commits = [],
  error,
} = Astro.props;

const flatDays = weeks.flat();
---

<article class="rounded-sm border border-border bg-surface p-5">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h3 class="text-lg font-semibold text-text">{label}</h3>
      <p class="mt-1 font-mono text-sm text-muted">
        <a
          href={profileUrl}
          class="text-accent no-underline hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          target="_blank"
          rel="noopener noreferrer"
        >
          @{username}
        </a>
      </p>
    </div>
    <p class="font-mono text-sm text-accent">{total} contributions (last year)</p>
  </header>

  {
    error ? (
      <p class="mt-4 text-sm text-muted" role="status">
        Could not load activity: {error}
      </p>
    ) : (
      <>
        <div class="mt-5 overflow-x-auto pb-2" role="img" aria-label={`${label} contribution calendar for ${username}`}>
          <div class="inline-grid grid-flow-col gap-[3px]" style={`grid-template-rows: repeat(7, 11px);`}>
            {flatDays.map((day) => (
              <span
                class:list={[
                  'size-[11px] rounded-[2px]',
                  day.level === 0 && 'bg-border',
                  day.level === 1 && 'bg-emerald-900',
                  day.level === 2 && 'bg-emerald-700',
                  day.level === 3 && 'bg-emerald-500',
                  day.level === 4 && 'bg-emerald-300',
                ]}
                title={`${day.date}: ${day.count} contribution${day.count === 1 ? '' : 's'}`}
              />
            ))}
          </div>
        </div>

        <div class="mt-3 flex items-center gap-2 text-xs text-muted" aria-hidden="true">
          <span>Less</span>
          <span class="size-[11px] rounded-[2px] bg-border"></span>
          <span class="size-[11px] rounded-[2px] bg-emerald-900"></span>
          <span class="size-[11px] rounded-[2px] bg-emerald-700"></span>
          <span class="size-[11px] rounded-[2px] bg-emerald-500"></span>
          <span class="size-[11px] rounded-[2px] bg-emerald-300"></span>
          <span>More</span>
        </div>

        <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">Recent commits</h4>
        {commits.length === 0 ? (
          <p class="mt-3 text-sm text-muted">No recent public push events found.</p>
        ) : (
          <ul class="mt-3 space-y-3" role="list">
            {commits.map((commit) => (
              <li class="border-b border-border/60 pb-3 last:border-0 last:pb-0">
                <a
                  href={commit.url}
                  class="text-sm text-text no-underline hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {commit.title}
                </a>
                <p class="mt-1 font-mono text-xs text-muted">
                  {commit.repo} · {new Date(commit.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </p>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</article>
