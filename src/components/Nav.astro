---                                                                                          
   import { site } from '../data/site.js';                                                      
                                                                                                
   const links = [                                                                              
     { href: '#projects', label: 'Projects' },                                                  
     { href: '#contributions', label: 'Open Source' },                                          
     { href: '#cicd', label: 'CI/CD' },                                                         
     { href: '/blog', label: 'Blog' },                                                          
   ];                                                                                           
   ---                                                                                          
                                                                                                
   <header class="sticky top-0 z-50 border-b border-border/80 bg-bg/90 backdrop-blur-md">       
     <nav                                                                                       
       class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"              
       aria-label="Primary"                                                                     
     >                                                                                          
       <a                                                                                       
         href="/"                                                                               
         class="font-mono text-sm font-semibold text-text no-underline hover:text-accent        
 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2                   
 focus-visible:outline-accent"                                                                  
       >                                                                                        
         {site.name}                                                                            
       </a>                                                                                     
                                                                                                
       <ul class="flex flex-wrap items-center gap-1 sm:gap-2">                                  
         {                                                                                      
           links.map((link) => (                                                                
             <li>                                                                               
               <a                                                                               
                 href={link.href}                                                               
                 class="rounded-sm px-2 py-1 text-sm text-muted no-underline hover:text-text    
 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2                   
 focus-visible:outline-accent"                                                                  
               >                                                                                
                 {link.label}                                                                   
               </a>                                                                             
             </li>                                                                              
           ))                                                                                   
         }                                                                                      
       </ul>                                                                                    
     </nav>                                                                                     
   </header>    