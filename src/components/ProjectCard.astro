---
import Badge from './Badge.astro';
import { ExternalLink, GitFork, Star } from '@lucide/astro';

const { project } = Astro.props;
---

<article
  class="project-card group flex h-full flex-col rounded-sm border border-border bg-surface p-5 transition duration-200 hover:-translate-y-0.5 hover:border-accent/30 hover:shadow-[0_0_0_1px_rgba(34,211,238,0.15)]"
  data-tech={project.tech.join(',')}
  aria-label={`Project: ${project.title}`}
>
  <header class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-lg font-semibold text-text group-hover:text-accent">{project.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{project.description}</p>
    </div>

    <ul class="flex shrink-0 items-center gap-3 text-xs text-muted" aria-label="Repository stats">
      <li class="inline-flex items-center gap-1" title="Stars">
        <Star class="size-3.5" aria-hidden="true" />
        <span>{project.stars}</span>
      </li>
      <li class="inline-flex items-center gap-1" title="Forks">
        <GitFork class="size-3.5" aria-hidden="true" />
        <span>{project.forks}</span>
      </li>
    </ul>
  </header>

  <div class="mt-4">
    <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted">Tech stack</p>
    <ul class="flex flex-wrap gap-2" aria-label="Technologies used">
      {
        project.tech.map((tech) => (
          <li>
            <button
              type="button"
              class="tech-tag cursor-pointer rounded-sm border border-border bg-bg px-2 py-0.5 text-xs text-text transition hover:border-accent/50 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              data-filter-tech={tech}
              aria-label={`Filter projects by ${tech}`}
            >
              {tech}
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-4">
    <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted">Deployment</p>
    <ul class="flex flex-wrap gap-2" aria-label="Deployment architecture">
      {
        project.deploy.map((item) => (
          <li>
            <Badge label={item} variant="muted" />
          </li>
        ))
      }
    </ul>
  </div>

  <footer class="mt-auto flex flex-wrap gap-3 pt-6">
    {
      project.demoUrl ? (
        <a
          href={project.demoUrl}
          class="inline-flex items-center gap-1.5 text-sm text-accent no-underline hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          target="_blank"
          rel="noopener noreferrer"
        >
          <ExternalLink class="size-4" aria-hidden="true" />
          Live demo
        </a>
      ) : (
        <span class="text-sm text-muted">Demo coming soon</span>
      )
    }

    <a
      href={project.sourceUrl}
      class="text-sm text-muted no-underline hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      target="_blank"
      rel="noopener noreferrer"
    >
      Source code
    </a>
  </footer>
</article>
