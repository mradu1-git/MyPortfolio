---                                                                                          
import { site } from '../data/site.js';                                                      
                                                                                            
const year = new Date().getFullYear();                                                       
---                                                                                          
                                                                                            
<footer class="mt-24 border-t border-border">                                                
    <div                                                                                       
    class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center       
sm:justify-between"                                                                            
    >                                                                                          
    <p class="text-sm text-muted">                                                           
        © {year} {site.name}. Built with Astro + Tailwind.                                     
    </p>                                                                                     
                                                                                            
    <ul class="flex flex-wrap gap-4" aria-label="Social links">                              
        {                                                                                      
        site.links.map((link) => (                                                           
            <li>                                                                               
            <a                                                                               
                href={link.href}                                                               
                class="text-sm text-muted no-underline hover:text-accent focus-visible:outline 
focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"           
                rel={link.id === 'email' ? undefined : 'noopener noreferrer'}                  
                target={link.id === 'email' ? undefined : '_blank'}                            
            >                                                                                
                {link.label}                                                                   
            </a>                                                                             
            </li>                                                                              
        ))                                                                                   
        }                                                                                      
    </ul>                                                                                    
    </div>                                                                                     
</footer>   