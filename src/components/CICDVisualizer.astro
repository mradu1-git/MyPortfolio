---
import { cicd } from '../data/cicd.js';
import { ArrowRight, GitBranch, Workflow } from '@lucide/astro';
---

<section id="cicd" class="border-t border-border" aria-labelledby="cicd-heading">
  <div class="mx-auto max-w-5xl px-4 py-16">
    <p class="font-mono text-sm text-accent">// infrastructure</p>
    <h2 id="cicd-heading" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
      CI/CD & GitOps workflow
    </h2>
    <p class="mt-3 max-w-2xl text-muted">
      How this portfolio is built, tested, containerized, and deployed — a GitOps-style pipeline
      targeting {cicd.deployTarget}.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={cicd.repoUrl}
        class="inline-flex items-center gap-2 rounded-sm border border-border bg-surface px-3 py-2 text-sm text-text no-underline transition hover:border-accent/40 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        target="_blank"
        rel="noopener noreferrer"
      >
        <GitBranch class="size-4" aria-hidden="true" />
        Repository
      </a>
      <a
        href={cicd.workflowUrl}
        class="inline-flex items-center gap-2 rounded-sm border border-border bg-surface px-3 py-2 text-sm text-text no-underline transition hover:border-accent/40 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Workflow class="size-4" aria-hidden="true" />
        GitHub Actions workflow
      </a>
    </div>

    <ol
      class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
      aria-label="CI/CD pipeline steps"
    >
      {
        cicd.steps.map((step, index) => (
          <li class="relative rounded-sm border border-border bg-surface p-4">
            <span class="font-mono text-xs text-accent">0{index + 1}</span>
            <h3 class="mt-2 font-medium text-text">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
            <p class="mt-3 font-mono text-xs text-muted">{step.tool}</p>
            {index < cicd.steps.length - 1 && (
              <ArrowRight
                class="absolute -right-3 top-1/2 hidden size-4 -translate-y-1/2 text-accent lg:block"
                aria-hidden="true"
              />
            )}
          </li>
        ))
      }
    </ol>

    <div class="mt-10 rounded-sm border border-border bg-surface p-5 font-mono text-sm">
      <p class="text-accent">git push origin main</p>
      <p class="mt-2 text-muted">→ lint → build → docker test → deploy</p>
      <p class="mt-2 text-muted">→ static assets served via NGINX or edge CDN</p>
    </div>
  </div>
</section>
