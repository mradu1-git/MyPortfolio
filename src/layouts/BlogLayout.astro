---
const { title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="mx-auto max-w-3xl px-4 py-16">
  <a
    href="/blog"
    class="text-sm text-muted no-underline hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    ← Back to blog
  </a>

  <header class="mt-6 border-b border-border pb-8">
    <time datetime={pubDate.toISOString()} class="font-mono text-sm text-accent">
      {formattedDate}
    </time>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    {description && <p class="mt-4 text-lg text-muted">{description}</p>}
  </header>

  <div class="prose mt-10">
    <slot />
  </div>
</article>
